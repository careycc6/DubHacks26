{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{data/catalog.json,data/household.json,data/offers.json,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
