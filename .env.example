# --- LLM (Gemini: also enters MLH "Best Use of Gemini API") ---
# Leave blank to run in rules-only mode (no LLM): commands like "court trial" still work.
GEMINI_API_KEY=
# Tried in order: Flash-Lite first (fastest), then Flash. On a rate limit or timeout the court moves to the next model.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# --- Photon 2.0 / Spectrum Cloud (app.photon.codes -> project) ---
# Leave blank to use only the local chat simulator at /sim.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Public URL used in links the agent texts (use an ngrok/cloudflared URL for real phones)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Optional: the Photon number, shown on the case file ("Text the court")
COURT_NUMBER=

# --- Storage (optional) ---
# MongoDB connection string (a free Atlas M0 cluster works). Blank = save to data/*.local.json on this computer.
# With it set, the cart, rulings, chat and household survive restarts, redeploys and moving to another machine.
MONGODB_URI=
MONGODB_DB=cartcourt

# --- Hosting (optional) ---
# On a hosted server, the dashboard and /setup are locked. Open https://<your-host>/?key=<ADMIN_TOKEN> once to unlock them in that browser.
# Make it long and random, e.g. `openssl rand -hex 24`.
ADMIN_TOKEN=

# --- Parent sign-in (optional): /login with Google or Apple. See ONBOARDING.md section 5. ---
# Google OAuth "Web application" client ID (authorized origin = your court's URL)
GOOGLE_CLIENT_ID=
# Apple Services ID (and the return URL registered for it; defaults to PUBLIC_URL/login)
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
# Signs the sign-in cookie. Long and random. Falls back to ADMIN_TOKEN.
SESSION_SECRET=
# Emails allowed to sign in without an invite, comma-separated
OWNER_EMAILS=
