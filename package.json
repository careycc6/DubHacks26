{
  "name": "cart-court",
  "version": "1.0.0",
  "description": "Cart Court: an honest phone-shopping agent for your group chat (DubHacks 26)",
  "scripts": {
    "dev": "node --use-system-ca --watch-path=src --watch-path=data/catalog.json --watch-path=data/household.json --watch-path=data/offers.json --watch-preserve-output --import tsx src/server.ts",
    "start": "node --use-system-ca --import tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc",
    "tunnel": "npx -y cloudflared@0.7.1 tunnel --url http://localhost:3000",
    "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.mjs --log-level=warning"
  },
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@vercel/functions": "^3.10.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mongodb": "^6.21.0",
    "qrcode": "^1.5.4",
    "spectrum-ts": "^12.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
